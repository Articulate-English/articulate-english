# Articulate English - environment template.
# Copy to .env (git-ignored) and fill in real values. Never commit .env.

# --- Classroom server (server/signaling-server.js) ---
# Demo accounts are seeded on first boot. If either password is unset or
# shorter than 8 characters, a random one is generated and printed once at
# startup - watch the console the first time you boot.
SEED_TEACHER_PASSWORD=
SEED_STUDENT_PASSWORD=

# Stripe (optional at boot; checkout returns "not configured" until set)
STRIPE_SECRET_KEY=

HTTP_PORT=8080
HTTPS_PORT=8443

# --- Tutoring platform (Teacher Student Classroom/tutoring-platform) ---
# The API refuses to boot if any of these is missing.
JWT_SECRET=
DATABASE_URL=
REDIS_URL=
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=tutoring
LIVEKIT_API_URL=http://livekit:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
FRONTEND_URL=https://articulate-english.github.io/articulate-english/
